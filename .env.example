

# ── Required ─────────────────────────────────────────────────────────────────
# The local Supabase stack prints these when you run `npx supabase start`.
# The values below are the Supabase CLI's standard local development keys —
# they are the same on every machine, they only work against 127.0.0.1, and
# they are safe to commit. Paste in whatever `supabase start` prints for you.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= 
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── Application ──────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# `full` opens the booking flow. `waitlist` shows the pre-opening site instead.
NEXT_PUBLIC_LAUNCH_MODE=full


# ── Payments ─────────────────────────────────────────────────────────────────
# This project ships no card acquirer and never will: `simulation` is a
# built-in fake gateway that walks the full checkout, webhook and receipt path
# without money moving. `disabled` closes checkout entirely.
#
#   simulation | disabled

PAYMENT_MODE=simulation


# ── Email ────────────────────────────────────────────────────────────────────
# `log`  — the default. Emails are printed to the server console, nothing is
#          sent, and no account of any kind is needed.
# `smtp` — sends for real through any free SMTP account. For Gmail, turn on
#          2-Step Verification, create an App Password
#          (Google Account → Security → App passwords) and use that 16-character
#          password below — not your normal Google password.

MAIL_TRANSPORT=log

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Addresses the application sends from and notifies. Any address works; with
# Gmail SMTP these should match SMTP_USER or Gmail will rewrite the sender.
EMAIL_GUEST_FROM=hello@wellplace.example
EMAIL_GUEST_FROM_NAME=WellPlace
EMAIL_OPERATIONS_FROM=notifications@wellplace.example
EMAIL_OPERATIONS_FROM_NAME=WellPlace notifications
EMAIL_OPERATIONS_TO=hello@wellplace.example

# Where email images and console links point. Localhost is allowed here so
# email previews render while you are running the demo.
EMAIL_ASSET_BASE_URL=http://localhost:3000
EMAIL_CONSOLE_URL=http://localhost:3000/manage/bookings


# ── Optional: social links in email footers ──────────────────────────────────

SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=


# ── Optional: analytics and monitoring ───────────────────────────────────────
# Leave empty and no tag, pixel or error reporter loads. That is the intended
# setting for a demo.

NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=
SENTRY_DSN=


# ── Optional: tests ──────────────────────────────────────────────────────────
# Used by the throwaway Postgres container the SQL and integration tests run
# against (`npm run db:test:up`). Not needed to run the app.

WELLPLACE_TEST_DB_NAME=wellplace-test-db
WELLPLACE_TEST_DB_PORT=54329
WELLPLACE_TEST_DB_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
WELLPLACE_TEST_REST_PORT=3001
WELLPLACE_TEST_REST_URL=http://127.0.0.1:3002

# Used by the Playwright end-to-end suite against a running demo.
WELLPLACE_E2E_BASE_URL=http://localhost:3000
WELLPLACE_E2E_EMAIL=manager@wellplace.example
WELLPLACE_E2E_PASSWORD=
