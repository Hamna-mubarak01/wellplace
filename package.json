{
  "name": "wellplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint",
    "lint:boundaries": "bash scripts/check-boundaries.sh",
    "verify": "tsc --noEmit && eslint && bash scripts/check-boundaries.sh && node scripts/check-contrast.mjs && vitest run",
    "db:test:up": "bash scripts/db-test-up.sh",
    "db:test:down": "bash scripts/db-test-down.sh",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:pgtap": "bash scripts/db-pgtap.sh",
    "db:seed:generate": "node --experimental-strip-types scripts/generate-seed.mjs",
    "db:rest:up": "bash scripts/db-rest-up.sh",
    "db:rest:down": "bash scripts/db-rest-down.sh",
    "check:contrast": "node scripts/check-contrast.mjs",
    "db:types": "supabase gen types typescript --db-url postgres://postgres:postgres@127.0.0.1:${WELLPLACE_TEST_DB_PORT:-54329}/postgres > src/types/database.generated.ts",
    "assets:build": "node scripts/build-flags.mjs && node scripts/build-og.mjs && node scripts/build-social-icons.mjs && node scripts/build-assets.mjs",
    "db:gateway": "node scripts/db-gateway.mjs",
    "demo": "npm run db:reset && npm run db:rest:up && concurrently -n gateway,next \"npm:db:gateway\" \"npm:dev\" || (echo; echo \"Run in two terminals: npm run db:gateway   and   npm run dev\")",
    "flags:build": "node scripts/build-flags.mjs",
    "staff:bootstrap": "node --env-file=.env scripts/bootstrap-owner.mjs",
    "demo:seed": "node --env-file=.env scripts/seed-demo.mjs",
    "og:build": "node scripts/build-og.mjs",
    "social:build": "node scripts/build-social-icons.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nextjs": "^10.71.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.10",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "react-phone-number-input": "^3.4.18",
    "sanitize-html": "^2.17.7",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "pg": "^8.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
